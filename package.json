{
	"name": "thoth-tauri",
	"version": "2026.11.9",
	"private": true,
	"description": "Private, offline voice transcription for macOS and Linux: press a key, speak, and the text lands at your cursor",
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint:css": "stylelint \"src/**/*.{css,svelte}\"",
		"lint:css:fix": "stylelint --fix \"src/**/*.css\"",
		"lint:drift": "node scripts/check-ui-drift.mjs",
		"lint:design": "node scripts/check-design-craft.mjs",
		"lint:design:live": "node scripts/check-design-craft.mjs --live",
		"test": "vitest",
		"test:run": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"tauri": "tauri"
	},
	"dependencies": {
		"@poodle64/design-tokens": "^2026.8.0",
		"@poodle64/ui": "^2026.11.12",
		"@tauri-apps/api": "2.12.5",
		"@tauri-apps/plugin-autostart": "2.7.0",
		"@tauri-apps/plugin-clipboard-manager": "2.5.0",
		"@tauri-apps/plugin-dialog": "2.8.1",
		"@tauri-apps/plugin-fs": "2.7.1",
		"@tauri-apps/plugin-process": "2.4.0",
		"@tauri-apps/plugin-updater": "^2.14.1",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"svelte-sonner": "^1.1.1",
		"sveltekit-superforms": "^3.1.0",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.17.0",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/cli": "2.12.5",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"formsnap": "^2.0.1",
		"impeccable": "4.1.0",
		"jsdom": "^31.0.0",
		"postcss-html": "^2.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"shadcn-svelte": "^1.3.0",
		"stylelint": "^18.0.0",
		"stylelint-config-html": "^2.0.0",
		"stylelint-config-standard": "^41.0.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwindcss": "^4.3.0",
		"typescript": "6.0.3",
		"vite": "8.3.8",
		"vitest": "^5.0.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
